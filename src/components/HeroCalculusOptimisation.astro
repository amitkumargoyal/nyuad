---
// Decorative optimisation picture for the course hero: f(x) = x·e^(−x/4) on a
// graph-paper grid, with a sloped tangent at x = 1.5 and the horizontal
// tangent at the maximiser x* = 4. f is concave on [0, 8], so both tangents
// lie on or above the curve and touch it once (checked numerically).
---
<svg class="hero-diagram" viewBox="0 0 230 178" fill="none" aria-hidden="true">
  <g stroke="#ece6db" stroke-width="1">
    <path d="M58 18 V146 M88 18 V146 M118 18 V146 M148 18 V146 M178 18 V146 M208 18 V146"/>
    <path d="M28 44 H214 M28 70 H214 M28 96 H214 M28 122 H214"/>
  </g>
  <!-- axes -->
  <path d="M28 12 V146 H214" stroke="#221d16" stroke-width="1.8" stroke-linecap="round"/>
  <!-- guide from the maximiser to the axis -->
  <path d="M102.4 32.0 V146" stroke="#9CAF88" stroke-width="1.4" stroke-dasharray="3 4"/>
  <!-- the function f(x) = x e^(-x/4) -->
  <path class="draw" d="M32.6 127.8 L36.3 115.0 L40.0 103.4 L43.7 93.0 L47.4 83.8 L51.1 75.5 L54.7 68.2 L58.4 61.8 L62.1 56.2 L65.8 51.3 L69.5 47.1 L73.1 43.5 L76.8 40.5 L80.5 38.0 L84.2 36.0 L87.9 34.4 L91.5 33.3 L95.2 32.5 L98.9 32.1 L102.6 32.0 L106.3 32.1 L110.0 32.5 L113.6 33.1 L117.3 34.0 L121.0 35.0 L124.7 36.2 L128.4 37.5 L132.0 38.9 L135.7 40.5 L139.4 42.2 L143.1 43.9 L146.8 45.7 L150.4 47.6 L154.1 49.5 L157.8 51.5 L161.5 53.5 L165.2 55.6 L168.9 57.6 L172.5 59.7 L176.2 61.8 L179.9 63.8 L183.6 65.9 L187.3 68.0 L190.9 70.0 L194.6 72.1 L198.3 74.1 L202.0 76.1 L205.7 78.0 L209.3 80.0" stroke="#5A1BA6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- tangents: sloped at x = 1.5, horizontal at the maximum x* = 4 -->
  <path class="draw d2" d="M31.7 109.4 L69.8 41.1" stroke="#A03A2C" stroke-width="1.6" stroke-linecap="round"/>
  <path class="draw d2" d="M81.9 32.0 H122.9" stroke="#A03A2C" stroke-width="1.6" stroke-linecap="round"/>
  <circle cx="55.9" cy="66.1" r="3.2" fill="#A03A2C" stroke="#FAF7F2" stroke-width="1.6"/>
  <circle cx="102.4" cy="32.0" r="4.5" fill="#A03A2C" stroke="#FAF7F2" stroke-width="2"/>
  <!-- labels -->
  <text x="102.4" y="160.0" text-anchor="middle" font-family="'STIX Two Text',serif" font-style="italic" font-size="12" fill="#6b6358">x*</text>
  <text x="130.9" y="36.0" text-anchor="start" font-family="'IBM Plex Mono',monospace" font-size="9.5" fill="#A03A2C">f′(x*) = 0</text>
  <text x="218.0" y="160.0" text-anchor="start" font-family="'STIX Two Text',serif" font-style="italic" font-size="12" fill="#6b6358">x</text>
  <text x="211.3" y="74.0" text-anchor="start" font-family="'STIX Two Text',serif" font-style="italic" font-size="12" fill="#5A1BA6">f</text>
</svg>
