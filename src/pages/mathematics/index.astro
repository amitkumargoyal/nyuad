---
import Course from '../../layouts/Course.astro';
import HeroMathematics from '../../components/HeroMathematics.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// ----- Interactive tools (standalone HTML files in public/mathematics/) -----
// Entries: { file, title, desc, glyph } — glyph is an 80×80 inline SVG miniature.
const tools = [
  {
    file: 'logic.html',
    title: 'Logic: propositions and quantifiers',
    desc: 'Complete equivalences, build formulas under constraints, translate English into symbols, negate ε–δ statements, and test quantified claims on a directed graph. Every answer is checked by truth table or by evaluation.',
    glyph: `<g transform="translate(0,-4)"><path d="M27.5 22.0 L45.0 22.0" stroke="#5A1BA6" stroke-width="2" stroke-linecap="round"/><path d="M51.0 22.0 L45.0 25.4 L45.0 18.6 Z" fill="#5A1BA6"/><path d="M56.4 28.6 L47.3 44.9" stroke="#5A1BA6" stroke-width="2" stroke-linecap="round"/><path d="M44.4 50.1 L44.3 43.2 L50.3 46.5 Z" fill="#5A1BA6"/><path d="M36.4 51.4 L27.3 35.1" stroke="#5A1BA6" stroke-width="2" stroke-linecap="round"/><path d="M24.4 29.9 L30.3 33.5 L24.3 36.8 Z" fill="#5A1BA6"/><path d="M35.7 64.1 C 28.7 79.2, 51.3 79.2, 47.4 70.6" stroke="#5A1BA6" stroke-width="2" stroke-linecap="round"/><path d="M45.0 65.1 L50.5 69.2 L44.3 72.0 Z" fill="#5A1BA6"/><circle cx="20" cy="22" r="7.5" fill="#fffdf9" stroke="#221d16" stroke-width="1.6"/><circle cx="60" cy="22" r="7.5" fill="#fffdf9" stroke="#221d16" stroke-width="1.6"/><circle cx="40" cy="58" r="7.5" fill="#fffdf9" stroke="#221d16" stroke-width="1.6"/></g>`,
  },
  {
    file: 'sets_relations_functions.html',
    title: 'Sets, relations, and functions',
    desc: 'Shade Venn regions and test set identities, compute products, power sets and preimages, decide the properties of a relation, and build relations and functions to a specification — or show that none exists.',
    glyph: `<defs><clipPath id="g2A"><circle cx="31" cy="32" r="17"/></clipPath><clipPath id="g2B"><circle cx="49" cy="32" r="17"/></clipPath><clipPath id="g2C"><circle cx="40" cy="48" r="17"/></clipPath></defs><g clip-path="url(#g2A)"><g clip-path="url(#g2B)"><g clip-path="url(#g2C)"><rect x="0" y="0" width="80" height="80" fill="#5A1BA6" opacity="0.55"/></g></g></g><circle cx="31" cy="32" r="17" fill="none" stroke="#221d16" stroke-width="1.6"/><circle cx="49" cy="32" r="17" fill="none" stroke="#221d16" stroke-width="1.6"/><circle cx="40" cy="48" r="17" fill="none" stroke="#221d16" stroke-width="1.6"/>`,
  },
  {
    file: 'partial_orders.html',
    title: 'Partial orders',
    desc: 'Read Hasse diagrams and order matrices, find maximal and minimal elements, build partial orders to a specification, analyse orders on intervals of the real line, and find Pareto-efficient points.',
    glyph: `<line x1="40" y1="64" x2="21" y2="40" stroke="#5A1BA6" stroke-width="2"/><line x1="40" y1="64" x2="59" y2="40" stroke="#5A1BA6" stroke-width="2"/><line x1="21" y1="40" x2="40" y2="16" stroke="#5A1BA6" stroke-width="2"/><line x1="59" y1="40" x2="40" y2="16" stroke="#5A1BA6" stroke-width="2"/><circle cx="40" cy="64" r="7" fill="#fffdf9" stroke="#221d16" stroke-width="1.6"/><circle cx="21" cy="40" r="7" fill="#fffdf9" stroke="#221d16" stroke-width="1.6"/><circle cx="59" cy="40" r="7" fill="#fffdf9" stroke="#221d16" stroke-width="1.6"/><circle cx="40" cy="16" r="7" fill="#5A1BA6" stroke="#221d16" stroke-width="1.6"/>`,
  },
  {
    file: 'rational_preferences.html',
    title: 'Rational preferences',
    desc: 'Test preference relations for completeness and transitivity, find choice sets, and construct utility functions — or show that none exists.',
    glyph: `<path d="M14 8 V66 H72" stroke="#221d16" stroke-width="1.6" fill="none"/><path d="M19.0 10.0 L21.2 26.6 L23.3 35.6 L25.4 41.3 L27.5 45.1 L29.7 48.0 L31.8 50.1 L33.9 51.8 L36.0 53.2 L38.1 54.3 L40.3 55.3 L42.4 56.1 L44.5 56.8 L46.6 57.4 L48.8 57.9 L50.9 58.3 L53.0 58.8 L55.1 59.1 L57.3 59.5 L59.4 59.8 L61.5 60.1 L63.6 60.3 L65.8 60.5 L67.9 60.8 L70.0 61.0" stroke="#5A1BA6" stroke-width="2" stroke-opacity="0.45" fill="none" stroke-linecap="round"/><path d="M25.2 10.0 L27.1 18.0 L28.9 24.0 L30.8 28.7 L32.7 32.4 L34.5 35.5 L36.4 38.0 L38.3 40.2 L40.1 42.0 L42.0 43.6 L43.9 45.0 L45.7 46.2 L47.6 47.3 L49.5 48.3 L51.3 49.2 L53.2 50.0 L55.1 50.7 L56.9 51.4 L58.8 52.0 L60.7 52.6 L62.5 53.1 L64.4 53.6 L66.3 54.0 L68.1 54.4 L70.0 54.8" stroke="#5A1BA6" stroke-width="2" stroke-opacity="0.7" fill="none" stroke-linecap="round"/><path d="M34.2 10.0 L35.7 13.9 L37.1 17.2 L38.6 20.2 L40.1 22.8 L41.6 25.1 L43.1 27.2 L44.6 29.1 L46.1 30.8 L47.6 32.4 L49.1 33.8 L50.6 35.1 L52.1 36.4 L53.6 37.5 L55.1 38.5 L56.6 39.5 L58.1 40.4 L59.5 41.2 L61.0 42.0 L62.5 42.7 L64.0 43.4 L65.5 44.1 L67.0 44.7 L68.5 45.3 L70.0 45.8" stroke="#5A1BA6" stroke-width="2" stroke-opacity="1" fill="none" stroke-linecap="round"/>`,
  },
];

// ----- Notes & exercises from the content collections -----
const byOrderThenDate = (a, b) =>
  (a.data.order ?? Infinity) - (b.data.order ?? Infinity) ||
  a.data.date.valueOf() - b.data.date.valueOf();

const notes = (await getCollection('math_notes', ({ data }) => !data.draft)).sort(byOrderThenDate);
const exercises = (await getCollection('math_exercises', ({ data }) => !data.draft)).sort(byOrderThenDate);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
const pad = (n: number) => String(n).padStart(2, '0');
---
<Course
  title="Mathematics — NYUAD"
  eyebrow="NYU Abu Dhabi · Course site"
  heading="Mathematics"
  lede="Interactive exercises, notes, and problem sets on the language of proof: logic, sets, functions, limits, and continuity."
  byline="Amit Goyal and Hervé Crès"
>
  <HeroMathematics slot="figure" />

  <section class="section">
    <div class="section-head">
      <h2 class="section-title">Interactive tools</h2>
      <div class="section-rule"></div>
      <div class="section-note">{tools.length > 0 ? `${tools.length} tool${tools.length === 1 ? "" : "s"}` : 'Coming soon'}</div>
    </div>
    {tools.length === 0 ? (
      <p class="empty-note">Interactive tools will appear here as the course progresses.</p>
    ) : (
      <div class="tools-grid">
        {tools.map((t, i) => (
          <a class="tool" href={`${base}/mathematics/${t.file}`}>
            <svg class="glyph" viewBox="0 0 80 80" fill="none" aria-hidden="true" set:html={t.glyph} />
            <div>
              <div class="tool-tag">Tool {pad(i + 1)}</div>
              <div class="tool-title">{t.title}</div>
              <div class="tool-desc">{t.desc}</div>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="section">
    <div class="section-head">
      <h2 class="section-title">Notes</h2>
      <div class="section-rule"></div>
      <div class="section-note">Lecture write-ups</div>
    </div>
    {notes.length === 0 ? (
      <p class="empty-note">Notes will appear here as the course progresses.</p>
    ) : (
      <div class="toc">
        {notes.map((n, i) => (
          <a class="toc-row" href={`${base}/mathematics/notes/${n.id}/`}>
            <div class="toc-num">{pad(i + 1)}</div>
            <div>
              <div class="toc-title">{n.data.title}</div>
              <div class="toc-desc">{n.data.description}</div>
            </div>
            <div class="toc-date">{fmtDate(n.data.date)}</div>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="section">
    <div class="section-head">
      <h2 class="section-title">Exercises</h2>
      <div class="section-rule"></div>
      <div class="section-note">Problem sets</div>
    </div>
    {exercises.length === 0 ? (
      <p class="empty-note">Problem sets will appear here as the course progresses.</p>
    ) : (
      <div class="toc">
        {exercises.map((e, i) => (
          <a class="toc-row" href={`${base}/mathematics/exercises/${e.id}/`}>
            <div class="toc-num">PS {i + 1}</div>
            <div>
              <div class="toc-title">{e.data.title}</div>
              <div class="toc-desc">{e.data.description}</div>
            </div>
            <div class="toc-date">{fmtDate(e.data.date)}</div>
          </a>
        ))}
      </div>
    )}
  </section>
</Course>
